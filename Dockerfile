# NextHire has three runnable pieces, each a build target of this file:
#
#   docker build -t nexthire-web .                               Next.js app (default)
#   docker build -t nexthire-socket --target socket .            Socket.IO server
#   docker build -t nexthire-migrate --target migrate .          prisma migrate deploy
#
# NEXT_PUBLIC_SOCKET_URL is compiled into the browser bundle, so pass it with
# --build-arg when building the web image. Setting it at runtime has no effect.
# Every other variable is read at runtime; see env-template.txt.

FROM node:24-bookworm-slim AS base
# Prisma's query engine links against OpenSSL, which the slim image leaves out.
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# All dependencies, including the Prisma CLI and the build tooling.
FROM base AS deps
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --no-audit --no-fund

FROM deps AS builder
ARG NEXT_PUBLIC_SOCKET_URL=""
ENV NEXT_PUBLIC_SOCKET_URL=$NEXT_PUBLIC_SOCKET_URL
COPY . .
# Not every checkout has a public/ directory, and git cannot track an empty one.
RUN mkdir -p public
# No database is available here. The prisma:error lines this prints while
# prerendering are expected, and the build still succeeds.
RUN npx prisma generate && npx next build

# Applies pending migrations, then exits. Needs DATABASE_URL.
FROM deps AS migrate
USER node
CMD ["npx", "prisma", "migrate", "deploy"]

# socket-server.js runs outside Next's standalone output, so it needs the
# production dependencies plus the Prisma client generated by the builder.
FROM base AS socket-deps
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

FROM base AS socket
ENV NODE_ENV=production
ENV SOCKET_SERVER_PORT=3002
COPY --from=socket-deps /app/node_modules ./node_modules
COPY package.json socket-server.js ./
USER node
EXPOSE 3002
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+process.env.SOCKET_SERVER_PORT+'/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
CMD ["node", "socket-server.js"]

# Keep this stage last so a plain `docker build .` produces the web app.
FROM base AS web
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+process.env.PORT+'/').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
CMD ["node", "server.js"]
